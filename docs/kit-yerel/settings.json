{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "6",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(git remote:*)",
      "PowerShell(git remote:*)",
      "Read(./.env)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/hook-guard-command.ps1"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/hook-guard-write.ps1"
          }
        ]
      },
      {
        "matcher": "mcp__UnityMCP__run_tests|mcp__unityMCP__run_tests|mcp__UnityMCP__refresh_unity|mcp__unityMCP__refresh_unity",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/hook-guard-mcp.ps1"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/hook-post-agent.ps1"
          }
        ]
      }
    ]
  }
}
